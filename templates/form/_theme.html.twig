{% use 'form_div_layout.html.twig' %}

{% block form_row -%}
    {%- set row_attr = row_attr|merge({class: ('form-row ' ~ (row_attr.class|default('')) ~ (errors|length ? ' has-error' : ''))|trim}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row %}

{% block checkbox_row -%}
    <div class="form-check{{ errors|length ? ' has-error' }}">
        {{- form_widget(form) -}}
        <div>
            {{- form_label(form) -}}
            {{- form_help(form) -}}
            {{- form_errors(form) -}}
        </div>
    </div>
{%- endblock checkbox_row %}

{% block hidden_row -%}
    {{- form_widget(form) -}}
    {{- form_errors(form) -}}
{%- endblock hidden_row %}

{% block form_help -%}
    {%- if help is not empty -%}
        <small id="{{ id }}_help" class="form-help">
            {{- translation_domain is same as(false) ? help : help|trans(help_translation_parameters, translation_domain) -}}
        </small>
    {%- endif -%}
{%- endblock form_help %}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}<li>{{ error.message }}</li>{%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}
