{% extends 'base.html.twig' %}

{% block title %}Le suivi connecté de votre cheval{% endblock %}

{% import '_partials/_icons.html.twig' as ui %}

{% block body %}
    {# ---------- Accueil ---------- #}
    <section class="hero" data-controller="hero" data-action="mousemove->hero#parallax">
        <div class="hero-glow" aria-hidden="true"></div>
        {# Courbes de niveau d'un pré, tracées à l'arrivée #}
        <svg class="hero-contours" viewBox="0 0 1440 640" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {% for i in 0..6 %}
                <path data-hero-target="contour" d="M-40 {{ 90 + i * 74 }} C 220 {{ 30 + i * 74 }}, 380 {{ 170 + i * 70 }}, 640 {{ 110 + i * 72 }} S 1080 {{ 20 + i * 78 }}, 1480 {{ 120 + i * 70 }}"/>
            {% endfor %}
        </svg>

        {# Instantanés « en direct » autour du logo (grands écrans) #}
        <div class="hero-float hero-float-a" data-hero-target="float" data-depth="18" aria-hidden="true">
            <span class="float-icon">{{ ui.icon('thermo') }}</span>
            <span><small>Sous la couverture</small><strong>27,4 °C · 61 %</strong></span>
        </div>
        <div class="hero-float hero-float-b" data-hero-target="float" data-depth="-24" aria-hidden="true">
            <span class="float-icon float-icon-live"><span class="live"></span></span>
            <span><small>Tornade · en direct</small><strong>Au trot · 3,2 km</strong></span>
        </div>
        <div class="hero-float hero-float-c" data-hero-target="float" data-depth="12" aria-hidden="true">
            <span class="float-icon float-icon-alert">{{ ui.icon('bell') }}</span>
            <span><small>Alerte · il y a 1 min</small><strong>Roulades répétées</strong></span>
        </div>
        <div class="hero-float hero-float-d" data-hero-target="float" data-depth="-14" aria-hidden="true">
            <span class="float-icon">{{ ui.icon('blanket') }}</span>
            <span><small>Conseil du soir</small><strong>Couverture 150 g</strong></span>
        </div>

        <div class="container">
            <p class="eyebrow" data-hero-target="fade">Boîtier connecté pour cheval</p>
            <h1 class="visually-hidden">Equitrack</h1>
            {{ include('_partials/_wordmark.html.twig', {link: false, class: 'wordmark-hero', attrs: 'data-controller="logo"'}) }}
            <hr class="rule" data-hero-target="fade">
            <p class="slogan" data-hero-target="slogan">Parce que son bien-être<br>ne prend jamais de pause.</p>
            <p class="lead" data-hero-target="fade">
                Un boîtier glissé dans la couverture suit votre cheval jour et nuit : où il est, comment il bouge,
                s'il a trop chaud ou trop froid. Equitrack interprète ces mesures, vous alerte au moindre signal
                inhabituel et vous conseille la bonne couverture.
            </p>
            <div class="actions" data-hero-target="fade">
                {% if app.user %}
                    <a class="btn btn-primary" data-controller="magnetic" href="{{ path('app_dashboard') }}">Voir mes chevaux <span class="arrow" aria-hidden="true">→</span></a>
                {% else %}
                    <a class="btn btn-primary" data-controller="magnetic" href="{{ path('app_register') }}">Créer un compte <span class="arrow" aria-hidden="true">→</span></a>
                    <a class="btn btn-ghost" data-controller="magnetic" href="{{ path('app_login') }}">Se connecter</a>
                {% endif %}
            </div>
        </div>
    </section>

    {# ---------- Démo animée ---------- #}
    <section class="container demo" data-controller="pasture-demo" aria-label="Démonstration : un cheval au pré suivi en direct">
        <div class="demo-card" data-reveal>
            <div class="demo-chrome" aria-hidden="true">
                <span class="chrome-dots"><i></i><i></i><i></i></span>
                <span class="chrome-url">{{ include('_partials/_horseshoe.html.twig', {class: 'chrome-shoe', stroke: 7}) }} equitrack · suivi en direct</span>
                <span class="chrome-live"><span class="live"></span>Direct</span>
            </div>
            <svg class="demo-map" viewBox="0 0 640 360" role="img" aria-label="Un cheval se déplace dans son enclos ; son trajet se dessine et une alerte part quand il sort.">
                <defs>
                    <pattern id="grass" width="22" height="22" patternUnits="userSpaceOnUse" patternTransform="rotate(18)">
                        <path d="M4 14q2-6 4 0M14 6q2-6 4 0" fill="none" stroke="#CFE1D6" stroke-width="1.2" stroke-linecap="round"/>
                    </pattern>
                </defs>
                <rect width="640" height="360" fill="#EEF5F0"/>
                <rect width="640" height="360" fill="url(#grass)" opacity=".7"/>
                <g class="contours" fill="none" stroke="#CFE1D6" stroke-width="1.2">
                    <path d="M-10 60 C120 20 260 90 380 40 S580 10 660 50"/>
                    <path d="M-10 320 C140 280 220 350 380 310 S560 270 660 300"/>
                    <path d="M560 360 C540 300 600 260 660 250"/>
                </g>
                <g class="trees" fill="#8DB89F">
                    <circle cx="560" cy="70" r="20" opacity=".55"/><circle cx="585" cy="88" r="15" opacity=".45"/>
                    <circle cx="48" cy="120" r="16" opacity=".5"/><circle cx="600" cy="300" r="22" opacity=".45"/>
                </g>
                <path d="M600 0 C590 90 610 160 640 210" fill="none" stroke="#C9DCEB" stroke-width="10" stroke-linecap="round" opacity=".8"/>
                <polygon class="fence" data-pasture-demo-target="fence" points="120,70 450,50 520,230 330,310 90,250"/>
                <path class="track" data-pasture-demo-target="track"
                      d="M200 200 C230 150 300 140 320 180 S380 250 420 200 S470 110 400 100 S280 110 250 160 S300 262 380 262 S480 230 492 180 C500 150 540 140 600 160"/>
                <g class="horse" data-pasture-demo-target="horse">
                    <circle class="halo" r="16"/>
                    <circle class="dot" r="8"/>
                </g>
            </svg>

            <aside class="demo-panel">
                <header>
                    <div>
                        <span class="eyebrow"><span class="live" aria-hidden="true"></span>En direct</span>
                        <h2>Tornade</h2>
                    </div>
                    <span class="badge badge-ok" data-pasture-demo-target="status">Dans l'enclos</span>
                </header>
                <dl class="demo-metrics">
                    <div><dt>Allure</dt><dd><span class="swap" data-pasture-demo-target="gait">Pas</span></dd></div>
                    <div><dt>Sous la couverture</dt><dd><span class="swap" data-pasture-demo-target="temperature">27,4</span> °C</dd></div>
                    <div><dt>Distance du jour</dt><dd><span data-pasture-demo-target="distance">0,0</span> km</dd></div>
                    <div>
                        <dt>Activité</dt>
                        <dd><span data-pasture-demo-target="activity">26</span><small>/100</small></dd>
                        <div class="meter"><span data-pasture-demo-target="activityBar"></span></div>
                    </div>
                </dl>
                <div class="demo-toast" data-pasture-demo-target="toast" role="status">
                    <span class="alert-dot critical" aria-hidden="true"></span>
                    <div>
                        <strong>Sortie d'enclos</strong>
                        <p>Tornade est sorti de son enclos. Alerte envoyée à l'instant.</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>

    {# ---------- Le boîtier en 3D, piloté par le défilement ---------- #}
    {% set chapters = [
        {kicker: 'Le prototype', title: 'Glissé dans la couverture, il ne la quitte plus', text: 'Voici la maquette du prototype réalisé pour notre projet de fin d\'études : un boîtier d\'environ 13 cm, coque arrondie imprimée en 3D, joint et pare-chocs souples côté cheval. Il se range dans une poche au poitrail et se recharge en USB-C. Formes et dimensions évolueront avec les essais.', chips: ['Prototype PFE', 'Étanchéité IP67 visée', 'USB-C']},
        {kicker: 'À l\'intérieur', title: 'Une carte tout-en-un et trois capteurs', text: 'Une seule carte réunit le processeur, le modem LTE-M, le GPS, le lecteur microSD et la recharge. Autour d\'elle : une centrale inertielle, une sonde sur câble, une carte SIM et une batterie clipsée dessous.', chips: ['Tout-en-un', 'Programmable en Arduino']},
        {kicker: 'F2 · F4 — Position', title: 'Il sait où est votre cheval, minute par minute', anchor: 'gnss', hotspot: 'Antenne GPS', text: 'Le GPS de la carte, relié à une antenne active collée sous le couvercle, relève un point par minute : position actuelle, trajet du jour, distance parcourue, et une alerte dès que le cheval sort de son enclos.', chips: ['1 point par minute', 'Antenne active', 'Enclos sur carte']},
        {kicker: 'F3 · F8 — Mouvements', title: 'Pas, trot, galop… et les roulades', anchor: 'imu', hotspot: 'Centrale inertielle', text: 'La centrale inertielle enregistre en continu en consommant très peu. Grâce à son IA intégrée et à sa grande mémoire tampon, elle reconnaît les allures, le cheval couché ou debout et les roulades. Les données brutes sont gardées sur la microSD pour entraîner les modèles.', chips: ['≥ 90 % des allures', 'Mesure en continu', 'IA intégrée']},
        {kicker: 'F1 · F9 — Climat', title: 'Ce qu\'il ressent sous la couverture', anchor: 'climate', hotspot: 'Sonde température et humidité', text: 'Une sonde déportée sur câble mesure la température et l\'humidité sous la couverture, au dixième de degré près, sans aucune carte électronique contre le cheval. Dehors, la plateforme s\'appuie sur la météo locale : l\'écart dit si la couverture isole trop ou pas assez.', chips: ['± 0,2 °C', 'Sonde sur câble', 'Météo locale']},
        {kicker: 'F5 — Transmission', title: 'Un envoi toutes les 10 minutes, l\'alerte tout de suite', anchor: 'lte', hotspot: 'Modem LTE-M', text: 'Le modem LTE-M de la carte et son antenne souple envoient les mesures toutes les 10 minutes, et tout de suite en cas d\'alerte. Une carte SIM IoT suffit, sans station à installer à l\'écurie. La 2G s\'éteint fin 2026 : Equitrack n\'en dépend pas.', chips: ['LTE-M', 'Toutes les 10 min', 'Alerte immédiate']},
        {kicker: 'Énergie', title: 'Une semaine entre deux recharges', anchor: 'battery', hotspot: 'Batterie', text: 'La batterie se clipse sous la carte, qui gère sa recharge et sa protection. Objectif : au moins 7 jours entre deux recharges, à confirmer par les mesures des essais. On recharge à l\'abri, en USB-C.', chips: ['7 jours visés', 'Recharge USB-C', 'Protection intégrée']},
        {kicker: 'Equitrack', title: 'Tout ça, au poitrail de votre cheval', text: 'Le boîtier mesure, le réseau transmet, la plateforme interprète. Vous, vous recevez l\'alerte quand il le faut, et le bon conseil de couverture chaque jour. Ce prototype sera validé pas à pas lors des essais en écurie.', chips: []},
    ] %}
    <section class="showcase" data-controller="device-showcase" aria-label="Le boîtier Equitrack en 3D">
        <div class="showcase-stage" data-device-showcase-target="stage">
            <canvas class="showcase-canvas" data-device-showcase-target="canvas" aria-hidden="true"></canvas>

            <p class="prototype-badge">
                <span class="prototype-dot" aria-hidden="true"></span>
                Maquette du prototype · le boîtier final peut différer
            </p>

            <div class="hotspot" data-device-showcase-target="hotspot" aria-hidden="true">
                <span class="hotspot-dot"></span>
                <span class="hotspot-label" data-device-showcase-target="hotspotLabel"></span>
            </div>

            <div class="container showcase-copy">
                {% for chapter in chapters %}
                    <article class="chapter" data-device-showcase-target="chapter" data-anchor="{{ chapter.anchor ?? '' }}" data-hotspot="{{ chapter.hotspot ?? '' }}">
                        <p class="eyebrow">{{ chapter.kicker }}</p>
                        <h2>{{ chapter.title }}</h2>
                        <p>{{ chapter.text }}</p>
                        {% if chapter.chips is not empty %}
                            <ul class="chips">{% for chip in chapter.chips %}<li>{{ chip }}</li>{% endfor %}</ul>
                        {% endif %}
                        {% if loop.last and not app.user %}
                            <a class="btn btn-primary" href="{{ path('app_register') }}">Commencer le suivi <span class="arrow" aria-hidden="true">→</span></a>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>

            <nav class="container showcase-nav" aria-label="Chapitres du boîtier">
                <ol class="showcase-dots">
                    {% for chapter in chapters %}
                        <li>
                            <button type="button" data-device-showcase-target="dot" data-action="device-showcase#goTo" data-device-showcase-index-param="{{ loop.index0 }}">{{ chapter.kicker }}</button>
                        </li>
                    {% endfor %}
                </ol>
                <div class="showcase-progress" aria-hidden="true"><span data-device-showcase-target="progress"></span></div>
            </nav>
        </div>
    </section>

    {# ---------- Chiffres clés ---------- #}
    <section class="section">
        <div class="container">
            <div class="grid grid-4 key-figures">
                <div data-reveal>
                    <span class="figure"><span data-count="995700">995 700</span></span>
                    <p>équidés en France fin 2024, pour environ 100 000 détenteurs.</p>
                </div>
                <div data-reveal>
                    <span class="figure"><span data-count="4">4</span><small> %</small></span>
                    <p>des chevaux font une colique chaque année.</p>
                </div>
                <div data-reveal>
                    <span class="figure"><span data-count="11">11</span><small> %</small></span>
                    <p>des coliques sont mortelles : les repérer tôt change l'issue.</p>
                </div>
                <div data-reveal>
                    <span class="figure"><span data-count="10">10</span><small> min</small></span>
                    <p>entre deux envois, et une alerte immédiate en cas de problème.</p>
                </div>
            </div>
            <p class="muted sources" data-reveal>Sources : IFCE, chiffres clés 2025 ; USDA, colique équine.</p>
        </div>
    </section>

    {# ---------- Bandeau défilant ---------- #}
    <div class="marquee" data-controller="marquee" aria-hidden="true">
        <div class="marquee-track" data-marquee-target="track">
            {% for word in ['Position', 'Allures', 'Roulades', 'Climat sous la couverture', 'Sortie d\'enclos', 'Conseil de couverture', 'Alertes'] %}
                <span>{{ word }}</span>{{ include('_partials/_horseshoe.html.twig', {class: 'marquee-shoe', stroke: 5}) }}
            {% endfor %}
        </div>
    </div>

    {# ---------- Fonctions : mosaïque illustrée ---------- #}
    <section class="section" id="fonctions">
        <div class="container">
            <div class="section-head" data-reveal>
                <p class="eyebrow">Ce que suit Equitrack</p>
                <h2>Les premiers signaux faibles, avant qu'ils ne deviennent un problème</h2>
                <p class="muted">La nuit et la plus grande partie de la journée, personne n'est auprès du cheval. Equitrack prend le relais.</p>
            </div>

            <div class="bento">
                {# Position et trajet #}
                <article class="feature bento-wide" data-reveal data-controller="tilt">
                    <div class="feature-visual visual-map" aria-hidden="true">
                        <svg viewBox="-130 0 780 180" preserveAspectRatio="xMidYMid slice">
                            <rect x="-130" width="780" height="180" fill="#EEF5F0"/>
                            <rect x="-130" width="780" height="180" fill="url(#grass)" opacity=".7"/>
                            <path d="M-140 150 C120 120 220 170 330 140 S470 110 660 130" fill="none" stroke="#CFE1D6" stroke-width="1.2"/>
                            <polygon class="mini-fence" points="70,30 330,22 400,110 250,160 50,130"/>
                            <path class="mini-track" pathLength="1" d="M120 100 C150 60 210 50 230 85 S280 140 310 105 S330 50 280 45 S190 60 170 95 S220 140 290 135"/>
                            <circle class="mini-dot" cx="290" cy="135" r="6"/>
                        </svg>
                        <span class="visual-tag">{{ ui.icon('route') }} 3,2 km aujourd'hui</span>
                    </div>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('pin') }}</div>
                        <div>
                            <h3>Position et trajet</h3>
                            <p>Position GPS actuelle, trajet de la journée et distance parcourue, sur une carte du pré.</p>
                        </div>
                    </div>
                </article>

                {# Climat sous la couverture #}
                <article class="feature" data-reveal data-controller="tilt">
                    <div class="feature-visual visual-climate" aria-hidden="true">
                        <div class="climate-reading">
                            <strong>27,4<small>°C</small></strong>
                            <span>61 % d'humidité</span>
                        </div>
                        <div class="climate-scale">
                            <span class="zone cold">Froid</span><span class="zone ok">Confort</span><span class="zone hot">Chaud</span>
                            <i class="needle"></i>
                        </div>
                    </div>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('thermo') }}</div>
                        <div>
                            <h3>Climat sous la couverture</h3>
                            <p>Température et humidité au contact du cheval, comparées à la météo locale.</p>
                        </div>
                    </div>
                </article>

                {# Allures #}
                <article class="feature" data-reveal data-controller="tilt">
                    <div class="feature-visual visual-gaits" aria-hidden="true">
                        {% for gait in [{n: 'Couché', h: 34, c: 'couche'}, {n: 'Repos', h: 58, c: 'repos'}, {n: 'Pas', h: 92, c: 'pas'}, {n: 'Trot', h: 46, c: 'trot'}, {n: 'Galop', h: 18, c: 'galop'}] %}
                            <div class="gait-col"><span class="bar g-{{ gait.c }}" style="--h: {{ gait.h }}%"></span><small>{{ gait.n }}</small></div>
                        {% endfor %}
                    </div>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('activity') }}</div>
                        <div>
                            <h3>Allures et comportement</h3>
                            <p>Pas, trot, galop, repos, cheval couché, roulades : la centrale inertielle reconnaît chaque allure.</p>
                        </div>
                    </div>
                </article>

                {# Activité inhabituelle #}
                <article class="feature" data-reveal data-controller="tilt">
                    <div class="feature-visual visual-anomaly" aria-hidden="true">
                        <svg viewBox="0 0 300 120" preserveAspectRatio="none">
                            <rect class="habit" x="0" y="52" width="300" height="34" rx="4"/>
                            <polyline class="spark" pathLength="1" points="0,74 22,68 44,72 66,64 88,70 110,62 132,68 154,66 176,71 198,60 214,24 230,66 252,70 274,64 300,68"/>
                            <circle class="spike" cx="214" cy="24" r="5"/>
                        </svg>
                        <span class="visual-tag visual-tag-alert">Agitation inhabituelle</span>
                    </div>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('bell') }}</div>
                        <div>
                            <h3>Activité inhabituelle</h3>
                            <p>Equitrack apprend les habitudes de votre cheval et signale l'agitation, l'immobilité ou les roulades répétées.</p>
                        </div>
                    </div>
                </article>

                {# Sortie d'enclos #}
                <article class="feature" data-reveal data-controller="tilt">
                    <div class="feature-visual visual-notify" aria-hidden="true">
                        <div class="notif notif-back"></div>
                        <div class="notif">
                            <span class="notif-app">{{ include('_partials/_horseshoe.html.twig', {class: 'notif-shoe', stroke: 7}) }}</span>
                            <span><strong>Sortie d'enclos</strong><small>Tornade a quitté son pré · à l'instant</small></span>
                        </div>
                    </div>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('fence') }}</div>
                        <div>
                            <h3>Sortie d'enclos</h3>
                            <p>Tracez l'enclos sur la carte : vous êtes prévenu dès que le cheval en sort.</p>
                        </div>
                    </div>
                </article>

                {# Conseil de couverture #}
                <article class="feature feature-dark bento-full" data-reveal>
                    <div class="feature-body">
                        <div class="icon">{{ ui.icon('blanket') }}</div>
                        <div>
                            <h3>Conseil de couverture</h3>
                            <p>Chaque jour, la bonne couverture selon la météo, la tonte, le profil du cheval et ce qui est mesuré dessous.</p>
                        </div>
                    </div>
                    <div class="advice-demo" aria-hidden="true">
                        <div class="advice-step"><span>{{ ui.icon('cloud') }}</span><small>Cette nuit</small><strong>2 °C · pluie 70 %</strong></div>
                        <span class="advice-plus">+</span>
                        <div class="advice-step"><span>{{ ui.icon('thermo') }}</span><small>Sous la couverture</small><strong>24,1 °C</strong></div>
                        <span class="advice-plus">=</span>
                        <div class="advice-step advice-result"><span>{{ ui.icon('blanket') }}</span><small>Conseil</small><strong>Imperméable 150 g</strong></div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {# ---------- Fonctionnement ---------- #}
    <section class="band" id="fonctionnement">
        <svg class="band-contours" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
            {% for i in 0..5 %}
                <path d="M-40 {{ 40 + i * 64 }} C 300 {{ i * 64 - 10 }}, 520 {{ 110 + i * 60 }}, 820 {{ 50 + i * 62 }} S 1200 {{ i * 66 }}, 1480 {{ 70 + i * 60 }}"/>
            {% endfor %}
        </svg>
        <div class="container">
            <div class="section-head" data-reveal>
                <p class="eyebrow">Fonctionnement</p>
                <h2>Du poitrail du cheval à votre téléphone</h2>
            </div>
            <ol class="flow">
                <li class="flow-step" data-reveal>
                    <div class="flow-node">{{ ui.icon('chip') }}</div>
                    <span class="flow-num">01</span>
                    <h3>Le boîtier mesure</h3>
                    <p>Fixé dans une poche de la couverture, il enregistre en continu les mouvements, la position, la température et l'humidité. Le brut reste sur sa carte microSD.</p>
                </li>
                <li class="flow-step" data-reveal>
                    <div class="flow-node step-icon-signal">{{ ui.icon('signal') }}</div>
                    <span class="flow-num">02</span>
                    <h3>Le réseau transmet</h3>
                    <p>Toutes les 10 minutes, un résumé part par le réseau mobile LTE-M. En cas d'alerte, l'envoi est immédiat.</p>
                </li>
                <li class="flow-step" data-reveal>
                    <div class="flow-node">{{ ui.icon('spark') }}</div>
                    <span class="flow-num">03</span>
                    <h3>Equitrack interprète</h3>
                    <p>La plateforme compare les mesures aux habitudes du cheval et à la météo, puis vous alerte et vous conseille.</p>
                </li>
            </ol>
        </div>
    </section>

    {# ---------- Appel à l'action ---------- #}
    <section class="section">
        <div class="container">
            <div class="cta-panel" data-reveal>
                {{ include('_partials/_horseshoe.html.twig', {class: 'cta-watermark', stroke: 2}) }}
                <div class="cta-copy">
                    <p class="eyebrow">{{ ui.icon('shield') }} À retenir</p>
                    <h2>Equitrack alerte, il ne diagnostique pas</h2>
                    <p>Au moindre doute sur la santé de votre cheval, appelez votre vétérinaire. L'historique d'Equitrack peut l'aider dans son examen.</p>
                    {% if not app.user %}
                        <a class="btn btn-light" data-controller="magnetic" href="{{ path('app_register') }}">Commencer le suivi <span class="arrow" aria-hidden="true">→</span></a>
                    {% endif %}
                </div>
                <div class="cta-contact">
                    <p class="eyebrow">Une question, un essai dans votre écurie&nbsp;?</p>
                    {{ include('_partials/_socials.html.twig') }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
