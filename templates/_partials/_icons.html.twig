{# Icônes au trait, partagées par toutes les pages : {% import '_partials/_icons.html.twig' as ui %} puis {{ ui.icon('pin') }}. #}
{% macro icon(name) %}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {%- if name == 'pin' -%}<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
        {%- elseif name == 'activity' -%}<path d="M3 12h4l2.5-6 5 12 2.5-6H21"/>
        {%- elseif name == 'thermo' -%}<path d="M14 14.8V5a2 2 0 1 0-4 0v9.8a4 4 0 1 0 4 0z"/><path d="M12 9v7"/>
        {%- elseif name == 'fence' -%}<path d="M4 20V7l2-3 2 3v13M16 20V7l2-3 2 3v13M8 10h8M8 16h8"/>
        {%- elseif name == 'bell' -%}<path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4z"/><path d="M10 20a2 2 0 0 0 4 0"/>
        {%- elseif name == 'blanket' -%}<path d="M4 7c3-2 13-2 16 0v10c-3 2-13 2-16 0z"/><path d="M8 6v12M16 6v12"/>
        {%- elseif name == 'chip' -%}<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>
        {%- elseif name == 'signal' -%}<path d="M12 20v-6"/><path class="wave w1" d="M8.5 10.5a5 5 0 0 1 7 0"/><path class="wave w2" d="M5.5 7.5a9 9 0 0 1 13 0"/><circle cx="12" cy="14" r="1.2" fill="currentColor"/>
        {%- elseif name == 'spark' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
        {%- elseif name == 'route' -%}<circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h8.5a3.5 3.5 0 0 0 0-7h-9a3.5 3.5 0 0 1 0-7H16"/>
        {%- elseif name == 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
        {%- elseif name == 'cloud' -%}<path d="M7 18h10a4 4 0 0 0 .5-7.97A6 6 0 0 0 6 11a3.5 3.5 0 0 0 1 7z"/><path d="M9 21l1-2M13 21l1-2"/>
        {%- elseif name == 'shield' -%}<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>
        {%- endif -%}
    </svg>
{% endmacro %}
