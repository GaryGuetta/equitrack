        <circle cx="18" cy="22" r="4.6"/><circle cx="18" cy="41" r="4.6"/>
        <circle cx="82" cy="22" r="4.6"/><circle cx="82" cy="41" r="4.6"/>
        <circle cx="29" cy="87" r="4.6"/><circle cx="71" cy="87" r="4.6"/>
    </g>
</svg>
