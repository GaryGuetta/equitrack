    <path class="shoe-outline" d="M7 5 H29 V62 A21 21 0 0 0 71 62 V5 H93 V62 A43 43 0 0 1 7 62 Z" fill="none" stroke="currentColor" stroke-width="{{ stroke ?? 5 }}" stroke-linejoin="round"/>
