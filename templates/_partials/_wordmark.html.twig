{# Logo : le « u » d'Equitrack est un fer à cheval dessiné au trait, posé sur la ligne de base, à la hauteur des minuscules.
   Variables : class (classes en plus), link (false pour un logo non cliquable), attrs (attributs bruts, ex. contrôleur Stimulus) #}
{% set tag = (link ?? true) ? 'a' : 'div' %}
<{{ tag }} class="wordmark {{ class ?? '' }}"{% if tag == 'a' %} href="{{ path(app.user ? 'app_dashboard' : 'app_home') }}"{% endif %} aria-label="Equitrack" {{ (attrs ?? '')|raw }}>
    <span class="wm-part" aria-hidden="true">Eq</span>
    {{- include('_partials/_horseshoe.html.twig', {class: 'shoe'}) -}}
    <span class="wm-part" aria-hidden="true">itrack</span>
</{{ tag }}>
