{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }}{% endblock %}

{% block body %}
    <div class="container page">
        <div class="card empty">
            <p class="eyebrow">Erreur {{ status_code }}</p>
            <h1>
                {% if status_code == 404 %}Cette page s'est échappée de l'enclos
                {% elseif status_code == 403 %}Accès réservé
                {% else %}Un problème est survenu{% endif %}
            </h1>
            <p>
                {% if status_code == 404 %}La page demandée n'existe pas ou a été déplacée.
                {% elseif status_code == 403 %}Vous n'avez pas accès à cette page.
                {% else %}Réessayez dans quelques instants.{% endif %}
            </p>
            <a class="btn btn-primary" href="{{ path('app_home') }}">Retour à l'accueil</a>
        </div>
    </div>
{% endblock %}
