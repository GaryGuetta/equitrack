<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Suivi connecté du cheval{% endblock %} · Equitrack</title>
        <meta name="description" content="{% block description %}Equitrack suit votre cheval 24 h/24 : position, activité, température sous la couverture, alertes et conseil de couverture.{% endblock %}">
        <meta name="theme-color" content="#1E3A2F">
        <meta name="view-transition" content="same-origin">
        {# Masque les éléments à révéler avant le premier rendu, sauf si l'utilisateur a demandé moins d'animations. #}
        <script>if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');</script>
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=Outfit:wght@400;500;600&display=swap">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{{ app.user ? 'is-auth' : 'is-guest' }}">
        {% set route = app.current_route %}
        <header class="site-header" data-controller="header">
            <div class="container">
                {{ include('_partials/_wordmark.html.twig') }}
                <nav class="nav" aria-label="Navigation principale">
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}" {{ route == 'app_dashboard' ? 'aria-current="page"' }}>Mes chevaux</a>
                        {% set alertCount = open_alert_count() %}
                        <a href="{{ path('app_alert_index') }}" {{ route == 'app_alert_index' ? 'aria-current="page"' }}>
                            Alertes{% if alertCount > 0 %} <span class="count" aria-label="{{ alertCount }} non traitées">{{ alertCount }}</span>{% endif %}
                        </a>
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" {{ route == 'app_login' ? 'aria-current="page"' }}>Connexion</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main data-controller="reveal">
            {% set flashes = app.flashes(['success', 'error']) %}
            {% if flashes.success is not empty or flashes.error is not empty %}
                <div class="container flashes" role="status">
                    {% for message in flashes.success %}<div class="flash" data-controller="flash">{{ message }}<button type="button" class="flash-close" data-action="flash#close" aria-label="Fermer">×</button></div>{% endfor %}
                    {% for message in flashes.error %}<div class="flash flash-error" data-controller="flash">{{ message }}<button type="button" class="flash-close" data-action="flash#close" aria-label="Fermer">×</button></div>{% endfor %}
                </div>
            {% endif %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            {{ include('_partials/_horseshoe.html.twig', {class: 'footer-watermark', stroke: 2}) }}
            <div class="container footer-top">
                <div class="footer-brand">
                    {{ include('_partials/_wordmark.html.twig') }}
                    <em>Parce que son bien-être ne prend jamais de pause.</em>
                    <p>Un boîtier glissé dans la couverture, une plateforme qui veille sur votre cheval jour et nuit.</p>
                </div>
                <nav class="footer-col" aria-label="Votre espace">
                    <h2>Votre espace</h2>
                    {% if app.user %}
                        <a href="{{ path('app_dashboard') }}">Mes chevaux</a>
                        <a href="{{ path('app_alert_index') }}">Alertes</a>
                        <a href="{{ path('app_horse_new') }}">Ajouter un cheval</a>
                    {% else %}
                        <a href="{{ path('app_login') }}">Connexion</a>
                        <a href="{{ path('app_register') }}">Créer un compte</a>
                    {% endif %}
                </nav>
                <div class="footer-col">
                    <h2>Nous écrire</h2>
                    {{ include('_partials/_socials.html.twig', {class: 'socials-stack'}) }}
                </div>
            </div>
            <div class="container footer-bottom">
                <span>© {{ 'now'|date('Y') }} Equitrack · Projet de fin d'études</span>
                <span>Equitrack alerte, il ne diagnostique pas : en cas de doute, appelez votre vétérinaire.</span>
            </div>
        </footer>
    </body>
</html>
